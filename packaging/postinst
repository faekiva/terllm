#!/bin/sh
# Enable terllm in the interactive shells of every normal user: append a marked block to ~/.bashrc / ~/.zshrc when that file exists.
# Detection is "the rc file exists" (a user who has a .zshrc uses zsh at least sometimes), not just the login shell. Symlinked rc files
# (dotfile managers) are left alone and only reported. The block is idempotent and removed again by postrm.
set -e
BEGIN='# >>> terllm (managed by the terllm package; removed with apt remove terllm) >>>'
END='# <<< terllm <<<'
DIR=/usr/lib/terllm/runtime

add() {                                  # add <rc file> <line>
    [ -f "$1" ] || return 0
    if [ -L "$1" ]; then echo "terllm: $1 is a symlink, not touched; add this line yourself: $2"; return 0; fi
    grep -qF "$BEGIN" "$1" && return 0
    [ -z "$(tail -c1 "$1")" ] || echo >> "$1"                         # file without a final newline
    printf '%s\n%s\n%s\n' "$BEGIN" "$2" "$END" >> "$1"              # append in place: owner and mode stay the user's
    echo "terllm: enabled in $1"
}

if [ "$1" = configure ]; then
    getent passwd | while IFS=: read -r name _ uid _ _ home shell; do
        [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
        case "$shell" in */nologin|*/false|"") continue ;; esac
        add "$home/.bashrc" "[ -r $DIR/terllm.bash ] && . $DIR/terllm.bash"
        add "$home/.zshrc" "[[ -r $DIR/terllm.zsh ]] && source $DIR/terllm.zsh"
    done
fi
exit 0
