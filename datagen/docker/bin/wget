#!/usr/bin/env python3
"""Offline wget shim: serves /srv/dl/<basename>; anything else falls through to real wget (real DNS failure)."""
import os, shutil, sys
args = sys.argv[1:]; out = None; urls = []; i = 0
while i < len(args):
    a = args[i]
    if a in ("-O", "--output-document"): out = args[i + 1]; i += 1
    elif a.startswith("-"): pass
    else: urls.append(a)
    i += 1
if len(urls) == 1 and os.path.exists(f"/srv/dl/{os.path.basename(urls[0].split('?')[0])}"):
    src = f"/srv/dl/{os.path.basename(urls[0].split('?')[0])}"
    shutil.copy(src, out or os.path.basename(src)); sys.exit(0)
os.execv("/usr/bin/wget", ["wget", *args])
