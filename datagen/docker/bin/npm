#!/usr/bin/env python3
"""Offline npm shim: `npm install|i|ci|add` of known packages writes stub node_modules; all else is real npm."""
import json, os, sys
sys.path.insert(0, "/opt/terllm")
from fixtures import NPM_PKGS
REAL = "/usr/bin/npm"
args = sys.argv[1:]
if not args or args[0] not in ("install", "i", "ci", "add") or "-g" in args or "--global" in args:
    os.execv(REAL, ["npm", *args])
flags = {a for a in args[1:] if a.startswith("-")}
pkgs = [a for a in args[1:] if not a.startswith("-")]
if not os.path.exists("package.json"):
    os.execv(REAL, ["npm", *args])
pj = json.load(open("package.json"))
dev = bool(flags & {"-D", "--save-dev"})
names = [p.split("@")[0] if not p.startswith("@") else p for p in pkgs]
want = names or list(pj.get("dependencies", {})) + list(pj.get("devDependencies", {}))
if any(n not in NPM_PKGS for n in want):
    os.execv(REAL, ["npm", *args])
for n in want:
    os.makedirs(f"node_modules/{n}", exist_ok=True)
    json.dump({"name": n, "version": "1.0.0"}, open(f"node_modules/{n}/package.json", "w"))
for n in names:
    pj.setdefault("devDependencies" if dev else "dependencies", {})[n] = "^1.0.0"
if names:
    json.dump(pj, open("package.json", "w"), indent=2); open("package.json", "a").write("\n")
os.makedirs("node_modules", exist_ok=True)
json.dump({"name": pj.get("name", "x"), "lockfileVersion": 3}, open("package-lock.json", "w"))
json.dump({}, open("node_modules/.package-lock.json", "w"))
print(f"\nadded {len(want)} packages, and audited {len(want)+1} packages in 1s\n\nfound 0 vulnerabilities")
