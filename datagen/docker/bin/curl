#!/usr/bin/env python3
"""Offline curl shim for -O / -o downloads of /srv/dl files; otherwise real curl."""
import os, shutil, sys
args = sys.argv[1:]; out = None; remote_name = False; urls = []; i = 0
while i < len(args):
    a = args[i]
    if a in ("-o", "--output"): out = args[i + 1]; i += 1
    elif a in ("-H", "-X", "-d", "--data", "-u", "-A", "--retry"): i += 1
    elif a == "--remote-name" or (a.startswith("-") and not a.startswith("--") and "O" in a): remote_name = True
    elif a.startswith("-"): pass
    else: urls.append(a)
    i += 1
if len(urls) == 1 and (out or remote_name):
    src = f"/srv/dl/{os.path.basename(urls[0].split('?')[0])}"
    if os.path.exists(src):
        shutil.copy(src, out or os.path.basename(src)); sys.exit(0)
os.execv("/usr/bin/curl", ["curl", *args])
