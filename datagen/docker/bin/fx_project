#!/usr/bin/env python3
"""fx_project DIR [LANG] [git] -> project tree in cwd (optionally a git repo with one commit)."""
import os, subprocess, sys
sys.path.insert(0, "/opt/terllm")
from fixtures import project_files

d, lang, git = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "docs"), "git" in sys.argv[3:]
for p, c in project_files(lang, os.path.basename(os.path.abspath(d))).items():
    os.makedirs(os.path.dirname(os.path.join(d, p)) or d, exist_ok=True)
    open(os.path.join(d, p), "w").write(c)
if git:
    for a in (["init", "-q", "-b", "main"], ["add", "-A"], ["commit", "-qm", "Initial commit"]):
        subprocess.run(["git", *a], cwd=d, check=True, capture_output=True)
