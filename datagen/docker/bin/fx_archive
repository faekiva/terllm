#!/usr/bin/env python3
"""fx_archive FILE.{tar.gz,tgz,tar.xz,tar.bz2,zip} [LANG] -> /srv/dl/FILE with top dir named after FILE."""
import os, subprocess, sys, tempfile
sys.path.insert(0, "/opt/terllm")
from fixtures import project_files

fn, lang = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "docs")
top = fn
for ext in (".tar.gz", ".tgz", ".tar.xz", ".tar.bz2", ".zip"):
    if fn.endswith(ext):
        top = fn[: -len(ext)]
os.makedirs("/srv/dl", exist_ok=True)
with tempfile.TemporaryDirectory() as t:
    for p, c in project_files(lang, top).items():
        os.makedirs(os.path.dirname(os.path.join(t, top, p)), exist_ok=True)
        open(os.path.join(t, top, p), "w").write(c)
    out = f"/srv/dl/{fn}"
    if fn.endswith(".zip"):
        subprocess.run(["zip", "-qr", out, top], cwd=t, check=True)
    else:
        flag = {"gz": "z", "tgz": "z", "xz": "J", "bz2": "j"}[fn.rsplit(".", 1)[1]]
        subprocess.run(["tar", f"-c{flag}f", out, top], cwd=t, check=True)
